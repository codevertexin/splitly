# =============================================================================
# Splitly — environment variables (CodeVertex ecosystem)
# =============================================================================
# Copy to `.env` for local development. Never commit secrets.
#
# FRONTEND (Vite) — safe to expose in the browser bundle:
# -----------------------------------------------------------------------------
# Splitly app identity & production URL
VITE_APP_CODE=SPLITLY
VITE_APP_BASE_URL=https://splitly.codevertex.cc
VITE_ECOSYSTEM_CODE=codevertex

# CodeVertex Core services (Auth, Billing, Help, Legal)
VITE_AUTH_BASE_URL=https://auth.codevertex.cc
VITE_BILLING_BASE_URL=https://billing.codevertex.cc
VITE_HELP_BASE_URL=https://help.codevertex.cc
VITE_LEGAL_BASE_URL=https://legal.codevertex.cc

# Splitly Supabase project (app data: groups, expenses, profiles)
# Required for the app to run.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Auth Core Supabase (reference only — used by Edge Functions, not for app queries)
# The Splitly frontend does NOT use these for data access; SSO is via sso-complete.
VITE_CODEVERTEX_SUPABASE_URL=
VITE_CODEVERTEX_SUPABASE_ANON_KEY=

# Optional: canonical site URL when building SSO callback without window (SSR/build)
# VITE_SITE_URL=https://splitly.codevertex.cc

# -----------------------------------------------------------------------------
# NEVER put these in the frontend / .env with VITE_ prefix:
# SUPABASE_SERVICE_ROLE_KEY
# STRIPE_SECRET_KEY
# SSO_SHARED_SECRET
# JWT_PRIVATE_KEY
# BILLING_SERVICE_TOKEN
# -----------------------------------------------------------------------------

# Edge Functions only (Supabase secrets — set in dashboard or `supabase secrets set`)
# SUPABASE_URL=          (auto)
# SUPABASE_ANON_KEY=     (auto)
# SUPABASE_SERVICE_ROLE_KEY=
# CODEVERTEX_SUPABASE_URL=
# CODEVERTEX_SUPABASE_ANON_KEY=
# BILLING_CORE_URL=https://billing.codevertex.cc
# BILLING_SERVICE_TOKEN=
# APP_BASE_URL=https://splitly.codevertex.cc
# CORS_ALLOWED_ORIGINS=  (comma-separated extra origins)
# ALLOW_LOCALHOST_CORS=true  (local dev only)

# Playwright E2E
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
PLAYWRIGHT_USER_EMAIL=tester@example.com
PLAYWRIGHT_USER_PASSWORD=change-me
PLAYWRIGHT_GROUP_NAME=Clube de Xadrez
PLAYWRIGHT_INITIAL_CYCLE=Março 2026
PLAYWRIGHT_EVENT_NAME=Jantar de turma
